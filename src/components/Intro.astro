---
const focus = [
	{ term: 'currently:', detail: 'Go, Kubernetes, TypeScript, React' },
	{ term: 'learning:', detail: 'AI tooling, CI/CD automation, DevOps' },
	{ term: 'interests:', detail: 'Cybersecurity, Backend Development & Linux' },
];
---

<header>
	<h1>Ross Condie</h1>
	<p class="role">
		Software Developer @ <a href="https://www.vier.ai/" target="_blank" rel="noopener noreferrer">VIER</a>
	</p>
	<p>Building tools that solve real problems.</p>
	<dl>
		{
			focus.map(({ term, detail }) => (
				<div>
					<dt>{term}</dt>
					<dd>{detail}</dd>
				</div>
			))
		}
	</dl>
	<p class="muted">
		Off the clock: looking into building a homelab, self-hosting, taking photos and eating the
		occasional slice of cheesecake.
	</p>
</header>

<style>
	header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
	}

	h1 {
		font-size: clamp(1.75rem, 5vw, 2.25rem);
	}

	.role {
		color: var(--color-muted);
		margin-top: calc(var(--space-1) * -1);
	}

	/* One grid for all rows so labels right-align on the colon and details share a left edge. */
	dl {
		display: grid;
		grid-template-columns: auto auto;
		gap: 0.25rem var(--space-1);
		text-align: left;
	}

	dl div {
		display: contents;
	}

	dt {
		color: var(--color-primary);
		font-weight: 600;
		text-align: right;
	}

	@media (max-width: 30rem) {
		dl {
			grid-template-columns: 1fr;
			text-align: center;
		}

		dt {
			text-align: center;
			margin-top: var(--space-1);
		}
	}

	.muted {
		color: var(--color-muted);
	}
</style>
