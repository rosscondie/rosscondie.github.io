---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Ross Condie',
	description = 'Software developer at VIER — Go, Kubernetes, TypeScript, React.',
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />
		<link rel="icon" href="/favicon.ico" />

		<!-- Social preview (Open Graph / Twitter) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Ross Condie" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Ross Condie — Software Developer @ VIER" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<main class="container">
			<slot />
			<footer>
				<small>&copy; {new Date().getFullYear()} Ross Condie</small>
			</footer>
		</main>
	</body>
</html>

<style>
	footer {
		color: var(--color-muted);
	}
</style>
